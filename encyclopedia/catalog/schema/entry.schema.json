{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/encyclopedia/entry.schema.json",
  "title": "CatalogEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "kind",
    "category",
    "maker",
    "description",
    "status",
    "confidence",
    "created_at",
    "updated_at",
    "last_verified_at",
    "history",
    "sources"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:--[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "kind": {
      "type": "string",
      "enum": ["tool", "product", "equipment", "software", "consumable", "service"]
    },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "maker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "country": { "type": "string" }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gtin": { "type": "string" },
        "mpn": { "type": "string" },
        "sku": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "catalog_no": { "type": "string" },
        "doi": { "type": "string" },
        "rrid": { "type": "string" },
        "repo_url": { "type": "string", "format": "uri" }
      }
    },
    "description": { "type": "string", "maxLength": 400 },
    "specs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/specValue" }
    },
    "offers": {
      "type": "array",
      "items": { "$ref": "#/$defs/offer" }
    },
    "status": {
      "type": "string",
      "enum": ["active", "discontinued", "announced", "unknown"]
    },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "last_verified_at": { "type": "string", "format": "date-time" },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$defs": {
    "specValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "value", "source", "evidence", "observed_at", "confidence"],
      "properties": {
        "raw": { "type": "string" },
        "value": {},
        "unit": { "type": "string" },
        "qualifier": {
          "type": "string",
          "enum": ["max", "min", "typical", "range"]
        },
        "range": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "source": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "evidence": { "type": "string", "maxLength": 300 },
        "observed_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "valid_until": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
        },
        "superseded_by": { "type": "string" }
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor",
        "url",
        "price",
        "currency",
        "price_type",
        "observed_at",
        "source"
      ],
      "properties": {
        "vendor": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "price": { "type": "number" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "price_type": {
          "type": "string",
          "enum": ["list", "sale", "quote"]
        },
        "region": { "type": "string" },
        "in_stock": { "type": "boolean" },
        "observed_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_id", "at", "run_id", "agent", "op", "path"],
      "properties": {
        "change_id": { "type": "string" },
        "at": { "type": "string", "format": "date-time" },
        "run_id": { "type": "string" },
        "agent": { "type": "string" },
        "op": {
          "type": "string",
          "enum": ["create", "set", "supersede", "merge", "split", "deprecate"]
        },
        "path": { "type": "string" },
        "old": {},
        "new": {},
        "source": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
