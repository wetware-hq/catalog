{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wetware.health/schemas/catalog-registry-entry.schema.json",
  "title": "Wetware catalog registry entry",
  "description": "An A2A AgentCard plus catalog metadata for routing. Domain-specific fields live under extensions, not inside the AgentCard core object.",
  "type": "object",
  "required": ["registryId", "domainId", "agentCard"],
  "properties": {
    "registryId": {
      "type": "string",
      "description": "Stable catalog identifier for this registered agent"
    },
    "domainId": {
      "type": "string",
      "description": "Biomedical domain bucket (e.g. peptides, infectious-diseases)"
    },
    "agentCard": {
      "$ref": "a2a-agent-card.schema.json"
    },
    "routing": {
      "type": "object",
      "description": "Catalog-owned hints for ranker (not part of A2A AgentCard)",
      "properties": {
        "priority": { "type": "number", "description": "Tie-break ordering when scores equal" },
        "indicationTags": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Clinical themes this agent addresses"
        },
        "contraindicationTags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "peptideSlugs": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Peptide slugs from evidence corpus this agent can discuss"
        }
      }
    },
    "skillEvidence": {
      "type": "object",
      "description": "Maps skill id -> claim_id references into peptide-claims.compact.json",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["claim_id", "verification_status"],
          "properties": {
            "claim_id": { "type": "string" },
            "verification_status": { "type": "string" },
            "verified": { "type": "boolean" }
          }
        }
      }
    }
  }
}
