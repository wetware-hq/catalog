{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wetware.health/schemas/rank-response.schema.json",
  "title": "Catalog rank response",
  "type": "object",
  "required": ["domainId", "disclaimer", "rankedAgents"],
  "properties": {
    "domainId": { "type": "string" },
    "disclaimer": { "type": "string" },
    "patientSummary": { "type": "object" },
    "rankedAgents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["registryId", "relevanceScore", "agentCard", "rationale"],
        "properties": {
          "registryId": { "type": "string" },
          "relevanceScore": { "type": "number", "minimum": 0, "maximum": 1 },
          "agentCard": { "$ref": "a2a-agent-card.schema.json" },
          "matchedSkills": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["skillId", "skillScore"],
              "properties": {
                "skillId": { "type": "string" },
                "skillScore": { "type": "number" },
                "matches": { "type": "array", "items": { "type": "object" } },
                "evidenceRefs": { "type": "array" }
              }
            }
          },
          "rationale": {
            "type": "object",
            "required": ["summary", "featureMatches"],
            "properties": {
              "summary": { "type": "string" },
              "featureMatches": { "type": "array" },
              "regulatoryAlerts": { "type": "array" },
              "contraindicationAlerts": { "type": "array" }
            }
          }
        }
      }
    }
  }
}
