flowchart TB
  subgraph entry [Entry points]
    CLI[catalog CLI\nrank list show validate serve]
    HTTP[node:http — 3 routes]
  end

  subgraph core [Core libraries]
    RANK[rank.ts pure rank]
    REG[registry.ts + validate]
    PAT[patient.ts]
    CORP[corpus.ts evidence load]
    CFG[config.ts]
    SRV[server.ts + Ajv schemas]
    GBUILD[build-graph.ts pure buildGraph]
  end

  subgraph data [Data and contracts]
    REGJSON[registry/domains/*.json]
    SCHEMAS[schemas/*.json]
    EVID[data/evidence/peptide-claims.compact.json]
    GITOID[data/evidence/peptide-claims.compact.gitoid]
    REFS[data/evidence/REFERENCES.md]
    KGX[graph/nodes.jsonl + edges.jsonl]
    FIX[fixtures/patients/*.json]
  end

  subgraph ci [CI]
    BUILD[npm run build]
    CHK[npm run check]
    TST[npm test]
  end

  CLI --> RANK
  CLI --> REG
  HTTP --> SRV
  SRV --> RANK
  SRV --> REG
  SRV --> SCHEMAS
  RANK --> CORP
  RANK --> REG
  REG --> REGJSON
  REG --> SCHEMAS
  REG --> CORP
  PAT --> FIX
  CORP --> EVID
  BUILD --> EVID
  GBUILD --> REGJSON
  GBUILD --> EVID
  GBUILD --> KGX
  CHK --> GITOID
  CHK --> REFS
  CHK --> KGX
  TST --> HTTP
